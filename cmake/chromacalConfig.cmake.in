@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenCV)
find_dependency(Ceres)
find_dependency(OpenColorIO)
find_dependency(Eigen3)
find_dependency(OpenMP)

if(OpenCV_VERSION VERSION_LESS 4.0)
  message(FATAL_ERROR "chromacal requires OpenCV 4.0 or newer, found ${OpenCV_VERSION}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/chromacalTargets.cmake")

check_required_components(chromacal)
